{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/projects",
      "destination": "/viwanja",
      "permanent": false
    },
    {
      "source": "/properties",
      "destination": "/viwanja",
      "permanent": false
    },
    {
      "source": "/maarifa",
      "destination": "/ardhimaarifa",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/((?!(?:ramani|fikasite|about|contact|login|register|robots\\.txt|sitemap\\.xml|favicon\\.ico|plotbase-logo\\.png|og-image\\.png|google9ce268f75432ba72(?:\\.html)?)/?$|assets(?:/|$)).+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}