{
  "redirects": [
    {
      "source": "/",
      "destination": "/viwanja",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "/viwanja",
      "permanent": false
    },
    {
      "source": "/properties",
      "destination": "/viwanja",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
"headers": [
  {
    "source": "/mashamba",
    "headers": [
      {
        "key": "X-Robots-Tag",
        "value": "noindex, nofollow"
      }
    ]
  },
  {
